{
  "version": 1,
  "profiles": [
    {
      "id": "sovereign-ai-node",
      "name": "Sovereign AI Node",
      "enabled": true,
      "lanePriorities": {
        "matrix": 4,
        "openclaw": 5,
        "mail_stack": 3,
        "ops_security": 4,
        "local_first_ai": 2
      },
      "keywords": [
        "sovereign ai node",
        "mail sentinel",
        "matrix",
        "element",
        "synapse",
        "federation",
        "openclaw",
        "clawd",
        "relay",
        "proton bridge",
        "imap",
        "ubuntu security",
        "self-hosted"
      ],
      "repoNames": [
        "ndee/sovereign-ai-node",
        "ndee/sovereign-ai-bots",
        "openclaw/openclaw",
        "matrix-org/synapse",
        "element-hq/element-web",
        "ProtonMail/proton-bridge"
      ],
      "organizations": [
        "ndee",
        "openclaw",
        "matrix-org",
        "element-hq",
        "ProtonMail"
      ],
      "sourceAllowlist": [
        "matrix-blog",
        "synapse-releases",
        "openclaw-releases",
        "openclaw-issues",
        "proton-bridge-releases",
        "ubuntu-security"
      ],
      "sourceBlocklist": [],
      "alerting": {
        "redThreshold": 14,
        "amberThreshold": 8,
        "digestInterval": "12h"
      }
    }
  ],
  "sources": [
    {
      "id": "matrix-blog",
      "name": "Matrix.org Blog",
      "type": "rss",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "matrix",
        "ops_security"
      ],
      "url": "https://matrix.org/atom.xml",
      "pollInterval": "30m",
      "maxItems": 6
    },
    {
      "id": "synapse-releases",
      "name": "Synapse Releases",
      "type": "github_releases",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "matrix",
        "ops_security"
      ],
      "owner": "matrix-org",
      "repo": "synapse",
      "pollInterval": "30m",
      "maxItems": 6
    },
    {
      "id": "element-web-releases",
      "name": "Element Web Releases",
      "type": "github_releases",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "matrix"
      ],
      "owner": "element-hq",
      "repo": "element-web",
      "pollInterval": "30m",
      "maxItems": 6
    },
    {
      "id": "openclaw-releases",
      "name": "OpenClaw Releases",
      "type": "github_releases",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "openclaw",
        "local_first_ai"
      ],
      "owner": "openclaw",
      "repo": "openclaw",
      "pollInterval": "30m",
      "maxItems": 6
    },
    {
      "id": "openclaw-issues",
      "name": "OpenClaw Issues",
      "type": "github_issues",
      "enabled": true,
      "trustTier": "community_high_signal",
      "lanes": [
        "openclaw",
        "local_first_ai"
      ],
      "owner": "openclaw",
      "repo": "openclaw",
      "state": "open",
      "pollInterval": "30m",
      "maxItems": 8
    },
    {
      "id": "openclaw-discussions",
      "name": "OpenClaw Discussions",
      "type": "github_discussions",
      "enabled": false,
      "trustTier": "community_high_signal",
      "lanes": [
        "openclaw",
        "local_first_ai"
      ],
      "owner": "openclaw",
      "repo": "openclaw",
      "githubTokenEnv": "GITHUB_TOKEN",
      "pollInterval": "30m",
      "maxItems": 8
    },
    {
      "id": "proton-bridge-releases",
      "name": "Proton Bridge Releases",
      "type": "github_releases",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "mail_stack",
        "ops_security"
      ],
      "owner": "ProtonMail",
      "repo": "proton-bridge",
      "pollInterval": "6h",
      "maxItems": 6
    },
    {
      "id": "ubuntu-security",
      "name": "Ubuntu Security Notices",
      "type": "rss",
      "enabled": true,
      "trustTier": "official",
      "lanes": [
        "ops_security"
      ],
      "url": "https://ubuntu.com/security/notices/rss.xml",
      "pollInterval": "6h",
      "maxItems": 8
    }
  ]
}
