{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "project-sentinel",
  "version": "2.0.0",
  "displayName": "Project Sentinel",
  "description": "Project intelligence sentinel that watches curated upstream and community sources, scores relevance to active project lanes, and routes red alerts or amber digests into Matrix.",
  "defaultInstall": false,
  "helloMessage": "Project Sentinel. Watches curated project sources, routes red alerts and amber digests into Matrix, and adjusts local routing from operator feedback.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "project-sentinel"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": true,
      "requireMention": false
    }
  },
  "configDefaults": {
    "pollInterval": "30m",
    "digestInterval": "12h",
    "statePath": "data/project-sentinel-state.json",
    "sourcesPath": "config/sources.json",
    "policyPath": "config/user-policy.json"
  },
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "project-sentinel-tool",
      "version": "2.0.0",
      "description": "Project intelligence watcher for curated upstream sources, local routing policy, red alerts, amber digests, and Matrix feedback.",
      "capabilities": [
        "project-sentinel.scan",
        "project-sentinel.feedback",
        "project-sentinel.status.read",
        "project-sentinel.sources.read"
      ],
      "requiredSecretRefs": [],
      "requiredConfigKeys": [
        "agentId",
        "statePath",
        "sourcesPath",
        "policyPath",
        "digestInterval"
      ],
      "allowedCommands": [
        "<agent-workspace>/bin/project-sentinel.js scan --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/project-sentinel.js digest --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/project-sentinel.js status --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/project-sentinel.js sources list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/project-sentinel.js sources enable --instance <tool-instance-id> --id <source-id> --json",
        "<agent-workspace>/bin/project-sentinel.js sources disable --instance <tool-instance-id> --id <source-id> --json",
        "<agent-workspace>/bin/project-sentinel.js feedback --instance <tool-instance-id> --latest --action <action> --json",
        "<agent-workspace>/bin/project-sentinel.js feedback --instance <tool-instance-id> --signal-id <signal-id> --action <action> --json"
      ],
      "openclawPlugins": [],
      "openclawBundledPlugins": [],
      "openclawToolNames": []
    }
  ],
  "toolInstances": [
    {
      "id": "project-sentinel-core",
      "templateRef": "project-sentinel-tool@2.0.0",
      "config": {
        "agentId": {
          "from": "agent.id"
        },
        "statePath": {
          "from": "instance.config.statePath"
        },
        "sourcesPath": {
          "from": "instance.config.sourcesPath"
        },
        "policyPath": {
          "from": "instance.config.policyPath"
        },
        "digestInterval": {
          "from": "instance.config.digestInterval"
        },
        "matrixAlertRoomId": {
          "from": "instance.matrix.alertRoom.roomId"
        }
      },
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/project-sentinel-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/project-sentinel-core/SKILL.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-bin",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/bin/project-sentinel.js"
          ]
        },
        "source": "workspace/bin/dist/project-sentinel.js",
        "mode": "0755",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-sources",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/config/sources.json"
          ]
        },
        "source": "workspace/config/sources.json",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-user-policy",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/config/user-policy.json"
          ]
        },
        "source": "workspace/config/user-policy.json",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-data-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/README.md"
          ]
        },
        "source": "workspace/data/README.md",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-state",
      "kind": "stateFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/project-sentinel-state.json"
          ]
        },
        "source": "workspace/data/project-sentinel-state.json",
        "writePolicy": "ifMissing"
      },
      "status": {
        "fields": {
          "lastScanAt": {
            "path": "lastScanAt",
            "type": "timestamp"
          },
          "lastAlertAt": {
            "path": "lastAlertAt",
            "type": "timestamp"
          },
          "consecutiveFailures": {
            "path": "consecutiveFailures",
            "type": "int",
            "default": 0
          },
          "lastError": {
            "path": "lastError",
            "type": "object"
          }
        }
      },
      "checks": [
        {
          "kind": "field-threshold",
          "id": "consecutive-failures",
          "field": "consecutiveFailures",
          "warnGte": 1,
          "failGte": 3
        }
      ]
    },
    {
      "id": "scan-service",
      "kind": "systemdService",
      "spec": {
        "name": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.service"
          ]
        },
        "description": {
          "join": [
            "Sovereign Project Sentinel Scan ",
            {
              "from": "instance.id"
            }
          ]
        },
        "after": [
          "network-online.target"
        ],
        "wants": [
          "network-online.target"
        ],
        "type": "oneshot",
        "user": {
          "from": "node.openclaw.serviceUser"
        },
        "group": {
          "from": "node.openclaw.serviceGroup"
        },
        "workingDirectory": {
          "from": "agent.workspace"
        },
        "environment": {
          "HOME": {
            "from": "node.openclaw.serviceHome"
          },
          "SOVEREIGN_NODE_CONFIG": {
            "from": "node.paths.configPath"
          },
          "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        },
        "execStart": [
          "/usr/bin/env",
          "node",
          {
            "join": [
              {
                "from": "agent.workspace"
              },
              "/bin/project-sentinel.js"
            ]
          },
          "scan",
          "--instance",
          {
            "from": "instance.toolInstanceIds.project-sentinel-core"
          },
          "--json"
        ],
        "timeoutStartSec": 300,
        "wantedBy": [],
        "desiredState": {
          "enabled": false,
          "active": false
        }
      }
    },
    {
      "id": "scan-timer",
      "kind": "systemdTimer",
      "dependsOn": [
        "scan-service"
      ],
      "spec": {
        "name": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.timer"
          ]
        },
        "description": {
          "join": [
            "Sovereign Project Sentinel Scan Timer ",
            {
              "from": "instance.id"
            }
          ]
        },
        "unit": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.service"
          ]
        },
        "onActiveSec": "5min",
        "onUnitActiveSec": {
          "convert": "duration.toSystemd",
          "value": {
            "default": [
              {
                "from": "bot.config.pollInterval"
              },
              "30m"
            ]
          }
        },
        "accuracySec": "1min",
        "persistent": true,
        "wantedBy": [
          "timers.target"
        ],
        "desiredState": {
          "enabled": true,
          "active": true
        }
      },
      "checks": [
        {
          "kind": "resource-state",
          "id": "timer-enabled",
          "property": "enabled",
          "equals": true,
          "severity": "fail"
        },
        {
          "kind": "resource-state",
          "id": "timer-active",
          "property": "active",
          "equals": true,
          "severity": "fail"
        }
      ]
    }
  ],
  "agentTemplate": {
    "id": "project-sentinel",
    "version": "2.0.0",
    "description": "Project intelligence sentinel for curated ecosystem sources, local routing policy, Matrix alerts, and digest-first delivery.",
    "matrix": {
      "localpartPrefix": "project-sentinel"
    },
    "requiredToolTemplates": [
      {
        "id": "project-sentinel-tool",
        "version": "2.0.0"
      }
    ],
    "optionalToolTemplates": []
  }
}
