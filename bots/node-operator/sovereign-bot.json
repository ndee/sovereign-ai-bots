{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "node-operator",
  "version": "2.1.0",
  "displayName": "Node Operator",
  "description": "Conversational operator for daily node status, health explanations and guided support, in the dedicated Sovereign Node control room.",
  "defaultInstall": true,
  "helloMessage": "Node Operator here. This is your node's control room \u2014 ask for `status` any time, or `help` to see what I can do.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "node-operator"
  },
  "matrixRouting": {
    "room": "operator",
    "dispatch": "deterministic",
    "dm": {
      "enabled": false
    },
    "alertRoom": {
      "autoReply": true,
      "requireMention": false
    }
  },
  "configDefaults": {
    "allowOperatorDms": false
  },
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "node-operator-tool",
      "version": "2.1.0",
      "description": "Read-only partner-support commands rendered from the product-safe diagnostics model",
      "capabilities": [
        "node.diagnostics.read"
      ],
      "requiredConfigKeys": [],
      "requiredSecretRefs": [],
      "allowedCommands": [
        "<agent-workspace>/bin/node-operator.js status",
        "<agent-workspace>/bin/node-operator.js health",
        "<agent-workspace>/bin/node-operator.js explain <code>",
        "<agent-workspace>/bin/node-operator.js support",
        "<agent-workspace>/bin/node-operator.js help",
        "<agent-workspace>/bin/node-operator.js version",
        "<agent-workspace>/bin/node-operator.js verify <nonce>"
      ],
      "openclawToolNames": []
    }
  ],
  "toolInstances": [
    {
      "id": "node-operator-core",
      "templateRef": "node-operator-tool@2.1.0",
      "config": {},
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/node-operator-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/node-operator-core/SKILL.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-bin",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/bin/node-operator.js"
          ]
        },
        "source": "workspace/bin/dist/node-operator.js",
        "mode": "0755",
        "writePolicy": "always"
      }
    },
    {
      "id": "operator-service",
      "kind": "systemdService",
      "spec": {
        "name": "sovereign-node-operator.service",
        "description": "Sovereign Node Operator (deterministic Matrix control-plane daemon)",
        "after": [
          "network-online.target"
        ],
        "wants": [
          "network-online.target"
        ],
        "type": "simple",
        "user": {
          "from": "node.openclaw.serviceUser"
        },
        "group": {
          "from": "node.openclaw.serviceGroup"
        },
        "workingDirectory": {
          "from": "agent.workspace"
        },
        "environment": {
          "HOME": {
            "from": "node.openclaw.serviceHome"
          },
          "SOVEREIGN_NODE_CONFIG": {
            "from": "node.paths.configPath"
          },
          "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        },
        "execStart": [
          "/usr/bin/node",
          {
            "join": [
              {
                "from": "agent.workspace"
              },
              "/bin/node-operator.js"
            ]
          },
          "serve"
        ],
        "restart": "always",
        "restartSec": "5",
        "wantedBy": [
          "multi-user.target"
        ],
        "desiredState": {
          "enabled": true,
          "active": true
        }
      }
    }
  ],
  "agentTemplate": {
    "id": "node-operator",
    "version": "2.1.0",
    "description": "Conversational operator for daily node status, health explanations and guided support, in the dedicated Sovereign Node control room.",
    "matrix": {
      "localpartPrefix": "node-operator"
    },
    "requiredToolTemplates": [
      {
        "id": "node-operator-tool",
        "version": "2.1.0"
      }
    ],
    "optionalToolTemplates": []
  }
}
