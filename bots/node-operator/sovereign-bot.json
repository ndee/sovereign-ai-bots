{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "node-operator",
  "version": "2.1.0",
  "displayName": "Node Operator",
  "description": "Conversational operator for daily node status, health explanations and guided support.",
  "defaultInstall": true,
  "helloMessage": "Node Operator here. Mention me with `status` for a health summary, or `help` to see what I can do.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "node-operator"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": false,
      "requireMention": true
    }
  },
  "configDefaults": {},
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "node-operator-tool",
      "version": "2.1.0",
      "description": "Read-only partner-support commands rendered from the product-safe diagnostics model",
      "capabilities": [
        "node.diagnostics.read"
      ],
      "requiredConfigKeys": [],
      "requiredSecretRefs": [],
      "allowedCommands": [
        "<agent-workspace>/bin/node-operator.js status",
        "<agent-workspace>/bin/node-operator.js health",
        "<agent-workspace>/bin/node-operator.js explain <code>",
        "<agent-workspace>/bin/node-operator.js support",
        "<agent-workspace>/bin/node-operator.js help",
        "<agent-workspace>/bin/node-operator.js version"
      ],
      "openclawToolNames": []
    }
  ],
  "toolInstances": [
    {
      "id": "node-operator-core",
      "templateRef": "node-operator-tool@2.1.0",
      "config": {},
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/node-operator-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/node-operator-core/SKILL.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-bin",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/bin/node-operator.js"
          ]
        },
        "source": "workspace/bin/dist/node-operator.js",
        "mode": "0755",
        "writePolicy": "always"
      }
    }
  ],
  "agentTemplate": {
    "id": "node-operator",
    "version": "2.1.0",
    "description": "Conversational operator for daily node status, health explanations and guided support.",
    "matrix": {
      "localpartPrefix": "node-operator"
    },
    "requiredToolTemplates": [
      {
        "id": "node-operator-tool",
        "version": "2.1.0"
      }
    ],
    "optionalToolTemplates": []
  }
}
