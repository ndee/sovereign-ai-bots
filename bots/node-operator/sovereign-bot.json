{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "node-operator",
  "version": "2.0.0",
  "displayName": "Node Operator",
  "description": "Conversational operator that manages Sovereign Node and managed agents.",
  "defaultInstall": false,
  "helloMessage": "Hello from Node Operator. Ask me for Sovereign Node and system status.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "node-operator"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": false,
      "requireMention": true
    }
  },
  "configDefaults": {},
  "toolInstances": [
    {
      "id": "node-operator-cli",
      "templateRef": "node-cli-ops@1.0.0",
      "config": {},
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/node-operator-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/node-operator-core/SKILL.md",
        "writePolicy": "always"
      }
    }
  ],
  "agentTemplate": {
    "id": "node-operator",
    "version": "2.0.0",
    "description": "Conversational operator that manages Sovereign Node and managed agents.",
    "matrix": {
      "localpartPrefix": "node-operator"
    },
    "requiredToolTemplates": [
      {
        "id": "node-cli-ops",
        "version": "1.0.0"
      }
    ],
    "optionalToolTemplates": [
      {
        "id": "imap-readonly",
        "version": "1.0.0"
      }
    ]
  }
}
