{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "reality-alignment",
  "version": "0.1.1",
  "displayName": "Reality Alignment",
  "description": "Experimental local-first Matrix self-coaching bot that tracks active wishes, daily alignment check-ins, resistance patterns, next aligned steps, and a weekly review digest.",
  "defaultInstall": false,
  "helloMessage": "Reality Alignment. Personal self-coaching bot for active wishes, daily check-ins, resistance tracking, next aligned steps, and weekly reviews. Not therapy. Not a manifestation engine.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "reality-alignment"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": true,
      "requireMention": false
    }
  },
  "configDefaults": {
    "statePath": "data/reality-alignment-state.json"
  },
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "reality-alignment-tool",
      "version": "0.1.1",
      "description": "Local self-coaching helper for wishes, alignment check-ins, resistance patterns, action steps, and weekly review digests.",
      "capabilities": [
        "reality-alignment.wish.read",
        "reality-alignment.wish.write",
        "reality-alignment.checkin.read",
        "reality-alignment.checkin.write",
        "reality-alignment.resistance.read",
        "reality-alignment.resistance.write",
        "reality-alignment.step.read",
        "reality-alignment.step.write",
        "reality-alignment.review.read"
      ],
      "requiredSecretRefs": [],
      "requiredConfigKeys": [
        "agentId",
        "statePath"
      ],
      "allowedCommands": [
        "<agent-workspace>/bin/reality-alignment.js wish add --instance <tool-instance-id> --title <title> --json",
        "<agent-workspace>/bin/reality-alignment.js wish list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js wish show --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js wish archive --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js wish complete --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js wish pause --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js checkin add --instance <tool-instance-id> --energy <score> --clarity <score> --congruence <score> --resistance <score> --json",
        "<agent-workspace>/bin/reality-alignment.js checkin list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js checkin latest --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js resistance add --instance <tool-instance-id> --label <label> --json",
        "<agent-workspace>/bin/reality-alignment.js resistance list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js resistance resolve --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js step next --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js step list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/reality-alignment.js step complete --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/reality-alignment.js review weekly --instance <tool-instance-id> --json"
      ],
      "openclawPlugins": [],
      "openclawBundledPlugins": [],
      "openclawToolNames": []
    }
  ],
  "toolInstances": [
    {
      "id": "reality-alignment-core",
      "templateRef": "reality-alignment-tool@0.1.1",
      "config": {
        "agentId": {
          "from": "agent.id"
        },
        "statePath": {
          "from": "instance.config.statePath"
        },
        "matrixAlertRoomId": {
          "from": "instance.matrix.alertRoom.roomId"
        }
      },
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/reality-alignment-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/reality-alignment-core/SKILL.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-bin",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/bin/reality-alignment.js"
          ]
        },
        "source": "workspace/bin/dist/reality-alignment.js",
        "mode": "0755",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-data-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/README.md"
          ]
        },
        "source": "workspace/data/README.md",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-state",
      "kind": "stateFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/reality-alignment-state.json"
          ]
        },
        "source": "workspace/data/reality-alignment-state.json",
        "writePolicy": "ifMissing"
      }
    }
  ],
  "agentTemplate": {
    "id": "reality-alignment",
    "version": "0.1.1",
    "description": "Personal self-coaching bot for active wishes, daily alignment check-ins, resistance patterns, next aligned steps, and weekly reviews. Reflective, grounded, action-oriented. Not therapy.",
    "model": "qwen/qwen3.5-27b",
    "matrix": {
      "localpartPrefix": "reality-alignment"
    },
    "requiredToolTemplates": [
      {
        "id": "reality-alignment-tool",
        "version": "0.1.1"
      }
    ],
    "optionalToolTemplates": []
  }
}
