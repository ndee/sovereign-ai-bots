{
  "kind": "sovereign-bot-package",
  "manifestVersion": 2,
  "id": "mail-sentinel",
  "version": "2.0.12",
  "displayName": "Mail Sentinel",
  "description": "Local-first inbox sentinel that filters heuristic candidates, reviews them with Lobster plus llm-task, applies personal policy, and chooses red, amber, or gray handling.",
  "defaultInstall": true,
  "helloMessage": "Mail Sentinel. Prefilters inbox signals, reviews relevant candidates, applies local policy, and routes messages into red alerts, amber digests, or gray silence.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "mail-sentinel"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": true,
      "requireMention": false
    }
  },
  "configDefaults": {
    "imapConfigured": false,
    "imapProtocol": "imap",
    "imapHost": "pending",
    "imapPort": 993,
    "imapTls": true,
    "imapUsername": "pending",
    "imapMailbox": "INBOX",
    "pollInterval": "30m",
    "lookbackWindow": "1h",
    "defaultReminderDelay": "4h",
    "digestInterval": "12h",
    "e2eeAlertRoom": false,
    "statePath": "data/mail-sentinel-state.json",
    "rulesPath": "config/default-rules.json",
    "policyPath": "config/user-policy.json",
    "openclawUrl": "http://127.0.0.1:18789",
    "llmModel": "qwen/qwen3.5-9b",
    "llmSenderDetail": "address",
    "llmTimeoutMs": 30000
  },
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "mail-sentinel-tool",
      "version": "2.0.0",
      "description": "Local-first mail watcher for heuristic candidate filtering, Lobster semantic review, policy-driven zoning, digests, and feedback tuning. Chat commands run through a typed tool; the scan uses a dedicated tool-less agent.",
      "capabilities": [
        "mail-sentinel.scan",
        "mail-sentinel.feedback",
        "mail-sentinel.alerts.read",
        "mail-sentinel.version.read",
        "mail-sentinel.status.read",
        "mail-sentinel.integrity.read"
      ],
      "openclawBundledPlugins": [
        "llm-task"
      ],
      "openclawToolNames": [],
      "requiredSecretRefs": [],
      "requiredConfigKeys": [
        "agentId",
        "imapInstanceId",
        "imapConfigured",
        "statePath",
        "rulesPath",
        "policyPath",
        "openclawUrl",
        "llmModel"
      ],
      "allowedCommands": [],
      "openclawTypedTool": {
        "name": "mail_sentinel",
        "description": "Mail Sentinel alerts, digest, feedback and sender policy for this node.",
        "script": "workspace/bin/dist/mail-sentinel.js",
        "operations": [
          {
            "name": "version",
            "description": "Report the running Mail Sentinel build.",
            "effect": "read",
            "argv": [
              "version",
              "--json"
            ]
          },
          {
            "name": "status",
            "description": "Report whether the mailbox connection and the scan are healthy.",
            "effect": "read",
            "argv": [
              "status",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ]
          },
          {
            "name": "list-alerts",
            "description": "List today's or recent alerts, with their alert ids.",
            "effect": "read",
            "argv": [
              "list-alerts",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ],
            "params": {
              "view": {
                "type": "string",
                "description": "today or recent",
                "enum": [
                  "today",
                  "recent"
                ],
                "argv": [
                  "--view",
                  "{value}"
                ]
              }
            },
            "required": [
              "view"
            ]
          },
          {
            "name": "digest",
            "description": "Show the pending amber digest.",
            "effect": "read",
            "argv": [
              "digest",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ]
          },
          {
            "name": "explain",
            "description": "Explain why one alert was flagged: matched rules, policy, reviewer verdict and final zone.",
            "effect": "read",
            "argv": [
              "explain",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ],
            "params": {
              "alertId": {
                "type": "string",
                "description": "Alert id from list-alerts",
                "pattern": "^[A-Za-z0-9-]{1,64}$",
                "maxLength": 64,
                "argv": [
                  "--alert-id",
                  "{value}"
                ]
              },
              "latest": {
                "type": "boolean",
                "description": "The newest alert",
                "argv": [
                  "--latest"
                ]
              },
              "ref": {
                "type": "string",
                "description": "Short alert reference shown in the room",
                "maxLength": 64,
                "argv": [
                  "--ref",
                  "{value}"
                ]
              }
            },
            "exactlyOneOf": [
              [
                "alertId",
                "latest",
                "ref"
              ]
            ]
          },
          {
            "name": "integrity",
            "description": "Report whether every mail was checked and name the messages that were not.",
            "effect": "read",
            "argv": [
              "integrity",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ]
          },
          {
            "name": "reconcile",
            "description": "Report the daily counts (no subjects or senders) for support.",
            "effect": "read",
            "argv": [
              "reconcile",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ]
          },
          {
            "name": "policy-list",
            "description": "List the sender, domain and other policies.",
            "effect": "read",
            "argv": [
              "policy",
              "list",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ]
          },
          {
            "name": "feedback",
            "description": "Record operator feedback on one alert. not-important, less-often, reduce and digest-only lower alerting: the tool returns a preview and a code, and the change applies only after the operator confirms it.",
            "effect": "change",
            "argv": [
              "feedback",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ],
            "params": {
              "alertId": {
                "type": "string",
                "description": "Alert id from list-alerts",
                "pattern": "^[A-Za-z0-9-]{1,64}$",
                "maxLength": 64,
                "argv": [
                  "--alert-id",
                  "{value}"
                ]
              },
              "latest": {
                "type": "boolean",
                "description": "The newest alert",
                "argv": [
                  "--latest"
                ]
              },
              "action": {
                "type": "string",
                "description": "important, not-important, less-often, remind-later, always-like-this, reduce or digest-only",
                "enum": [
                  "important",
                  "not-important",
                  "less-often",
                  "remind-later",
                  "always-like-this",
                  "reduce",
                  "digest-only"
                ],
                "argv": [
                  "--action",
                  "{value}"
                ]
              },
              "delay": {
                "type": "string",
                "description": "Reminder delay for remind-later, e.g. 30m, 4h or 2d (at most 999m, 99h or 7d)",
                "pattern": "^([1-9][0-9]{0,2}m|[1-9][0-9]?h|[1-7]d)$",
                "maxLength": 4,
                "argv": [
                  "--delay",
                  "{value}"
                ]
              },
              "scope": {
                "type": "string",
                "description": "How broadly always-like-this, reduce or digest-only applies: item (default), sender, domain, subject or content",
                "enum": [
                  "item",
                  "sender",
                  "domain",
                  "subject",
                  "content"
                ],
                "argv": [
                  "--scope",
                  "{value}"
                ]
              },
              "contains": {
                "type": "string",
                "description": "Token for a subject or content scope",
                "maxLength": 200,
                "argv": [
                  "--contains",
                  "{value}"
                ]
              }
            },
            "required": [
              "action"
            ],
            "exactlyOneOf": [
              [
                "alertId",
                "latest"
              ]
            ],
            "confirm": {
              "param": "action",
              "values": [
                "not-important",
                "less-often",
                "reduce",
                "digest-only"
              ]
            },
            "confirmPreviewArgv": [
              "--dry-run"
            ]
          },
          {
            "name": "policy-important-sender",
            "description": "Mark the sender that matches the query as important and post a confirmation in the alert room.",
            "effect": "change",
            "argv": [
              "policy",
              "important-sender",
              "--instance",
              "<tool-instance-id>",
              "--announce",
              "--json"
            ],
            "params": {
              "query": {
                "type": "string",
                "description": "Name or address of the sender, as the operator wrote it",
                "maxLength": 200,
                "argv": [
                  "--query",
                  "{value}"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          {
            "name": "policy-add",
            "description": "Add a sender, domain or receiver policy that keeps matching mail at least at the given zone.",
            "effect": "change",
            "argv": [
              "policy",
              "add",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ],
            "params": {
              "type": {
                "type": "string",
                "description": "sender, domain or receiver",
                "enum": [
                  "sender",
                  "domain",
                  "receiver"
                ],
                "argv": [
                  "--type",
                  "{value}"
                ]
              },
              "match": {
                "type": "string",
                "description": "Address, domain or pattern to match",
                "maxLength": 200,
                "argv": [
                  "--match",
                  "{value}"
                ]
              },
              "minZone": {
                "type": "string",
                "description": "red or amber",
                "enum": [
                  "red",
                  "amber"
                ],
                "argv": [
                  "--min-zone",
                  "{value}"
                ]
              }
            },
            "required": [
              "type",
              "match",
              "minZone"
            ]
          },
          {
            "name": "policy-remove",
            "description": "Remove one policy by id. This can lower alerting and needs the operator's confirmation.",
            "effect": "change",
            "argv": [
              "policy",
              "remove",
              "--instance",
              "<tool-instance-id>",
              "--json"
            ],
            "params": {
              "id": {
                "type": "string",
                "description": "Policy id from policy-list",
                "pattern": "^[A-Za-z0-9-]{1,64}$",
                "maxLength": 64,
                "argv": [
                  "--id",
                  "{value}"
                ]
              }
            },
            "required": [
              "id"
            ],
            "confirm": "always"
          }
        ]
      },
      "openclawScanAgent": {
        "toolNames": [
          "llm-task"
        ]
      }
    }
  ],
  "toolInstances": [
    {
      "id": "mail-sentinel-imap",
      "templateRef": "imap-readonly@1.0.0",
      "enabledWhen": {
        "path": "instance.config.imapConfigured",
        "equals": true
      },
      "config": {
        "protocol": {
          "from": "instance.config.imapProtocol"
        },
        "host": {
          "from": "instance.config.imapHost"
        },
        "port": {
          "from": "instance.config.imapPort",
          "stringify": true
        },
        "tls": {
          "from": "instance.config.imapTls",
          "stringify": true
        },
        "username": {
          "from": "instance.config.imapUsername"
        },
        "mailbox": {
          "from": "instance.config.imapMailbox"
        }
      },
      "secretRefs": {
        "password": {
          "from": "instance.secretRefs.imapPassword"
        }
      }
    },
    {
      "id": "mail-sentinel-core",
      "templateRef": "mail-sentinel-tool@2.0.0",
      "config": {
        "agentId": {
          "from": "agent.id"
        },
        "imapInstanceId": {
          "from": "instance.toolInstanceIds.mail-sentinel-imap"
        },
        "imapConfigured": {
          "from": "instance.config.imapConfigured",
          "stringify": true
        },
        "statePath": {
          "from": "instance.config.statePath"
        },
        "rulesPath": {
          "from": "instance.config.rulesPath"
        },
        "policyPath": {
          "from": "instance.config.policyPath"
        },
        "lookbackWindow": {
          "from": "instance.config.lookbackWindow"
        },
        "pollInterval": {
          "from": "instance.config.pollInterval"
        },
        "defaultReminderDelay": {
          "from": "instance.config.defaultReminderDelay"
        },
        "digestInterval": {
          "from": "instance.config.digestInterval"
        },
        "openclawUrl": {
          "from": "instance.config.openclawUrl"
        },
        "llmModel": {
          "from": "instance.config.llmModel"
        },
        "llmSenderDetail": {
          "from": "instance.config.llmSenderDetail"
        },
        "llmTimeoutMs": {
          "from": "instance.config.llmTimeoutMs",
          "stringify": true
        },
        "matrixAlertRoomId": {
          "from": "instance.matrix.alertRoom.roomId"
        }
      },
      "secretRefs": {}
    }
  ],
  "hostResources": [
    {
      "id": "workspace-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/README.md"
          ]
        },
        "source": "workspace/README.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-agents",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/AGENTS.md"
          ]
        },
        "source": "workspace/AGENTS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-tools",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/TOOLS.md"
          ]
        },
        "source": "workspace/TOOLS.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-skill",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/skills/mail-sentinel-core/SKILL.md"
          ]
        },
        "source": "workspace/skills/mail-sentinel-core/SKILL.md",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-bin",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/bin/mail-sentinel.js"
          ]
        },
        "source": "workspace/bin/dist/mail-sentinel.js",
        "mode": "0755",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-default-rules",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/config/default-rules.json"
          ]
        },
        "source": "workspace/config/default-rules.json",
        "writePolicy": "always"
      }
    },
    {
      "id": "workspace-user-policy",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/config/user-policy.json"
          ]
        },
        "source": "workspace/config/user-policy.json",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-data-readme",
      "kind": "managedFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/README.md"
          ]
        },
        "source": "workspace/data/README.md",
        "writePolicy": "ifMissing"
      }
    },
    {
      "id": "workspace-state",
      "kind": "stateFile",
      "spec": {
        "path": {
          "join": [
            {
              "from": "agent.workspace"
            },
            "/data/mail-sentinel-state.json"
          ]
        },
        "inlineContent": "{\n  \"consecutiveFailures\": 0\n}",
        "writePolicy": "ifMissing"
      },
      "status": {
        "fields": {
          "lastPollAt": {
            "path": "lastPollAt",
            "type": "timestamp"
          },
          "lastAlertAt": {
            "path": "lastAlertAt",
            "type": "timestamp"
          },
          "consecutiveFailures": {
            "path": "consecutiveFailures",
            "type": "int",
            "default": 0
          },
          "lastScanLlmFailures": {
            "path": "lastScanLlmFailures",
            "type": "int",
            "default": 0
          },
          "lastScanWarnings": {
            "path": "lastScanWarnings",
            "type": "int",
            "default": 0
          },
          "lastError": {
            "path": "lastError",
            "type": "object"
          }
        }
      },
      "checks": [
        {
          "kind": "field-threshold",
          "id": "consecutive-failures",
          "field": "consecutiveFailures",
          "warnGte": 1,
          "failGte": 3
        },
        {
          "kind": "field-threshold",
          "id": "llm-classification-failures",
          "field": "lastScanLlmFailures",
          "warnGte": 1,
          "failGte": 3
        }
      ]
    },
    {
      "id": "scan-service",
      "kind": "systemdService",
      "spec": {
        "name": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.service"
          ]
        },
        "description": {
          "join": [
            "Sovereign Mail Sentinel Scan ",
            {
              "from": "instance.id"
            }
          ]
        },
        "after": [
          "network-online.target"
        ],
        "wants": [
          "network-online.target"
        ],
        "type": "oneshot",
        "user": {
          "from": "node.openclaw.serviceUser"
        },
        "group": {
          "from": "node.openclaw.serviceGroup"
        },
        "workingDirectory": {
          "from": "agent.workspace"
        },
        "environment": {
          "HOME": {
            "from": "node.openclaw.serviceHome"
          },
          "SOVEREIGN_NODE_CONFIG": {
            "from": "node.paths.configPath"
          },
          "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        },
        "execStart": [
          "/usr/bin/env",
          "node",
          {
            "join": [
              {
                "from": "agent.workspace"
              },
              "/bin/mail-sentinel.js"
            ]
          },
          "scan",
          "--instance",
          {
            "from": "instance.toolInstanceIds.mail-sentinel-core"
          },
          "--json"
        ],
        "timeoutStartSec": 300,
        "wantedBy": [],
        "desiredState": {
          "enabled": false,
          "active": false
        }
      }
    },
    {
      "id": "scan-timer",
      "kind": "systemdTimer",
      "dependsOn": [
        "scan-service"
      ],
      "supersedes": [
        {
          "kind": "openclawCron",
          "match": {
            "name": {
              "join": [
                {
                  "from": "instance.id"
                },
                "-poll"
              ]
            },
            "agentId": {
              "from": "agent.id"
            }
          }
        }
      ],
      "spec": {
        "name": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.timer"
          ]
        },
        "description": {
          "join": [
            "Sovereign Mail Sentinel Scan Timer ",
            {
              "from": "instance.id"
            }
          ]
        },
        "unit": {
          "join": [
            "sovereign-",
            {
              "from": "instance.id"
            },
            "-scan.service"
          ]
        },
        "onActiveSec": "5min",
        "onUnitActiveSec": {
          "convert": "duration.toSystemd",
          "value": {
            "default": [
              {
                "from": "bot.config.pollInterval"
              },
              "30m"
            ]
          }
        },
        "accuracySec": "1min",
        "persistent": true,
        "wantedBy": [
          "timers.target"
        ],
        "desiredState": {
          "enabled": true,
          "active": true
        }
      },
      "checks": [
        {
          "kind": "resource-state",
          "id": "timer-enabled",
          "property": "enabled",
          "equals": true,
          "severity": "fail"
        },
        {
          "kind": "resource-state",
          "id": "timer-active",
          "property": "active",
          "equals": true,
          "severity": "fail"
        }
      ]
    }
  ],
  "agentTemplate": {
    "id": "mail-sentinel",
    "version": "2.0.12",
    "description": "Local-first inbox sentinel that filters heuristic candidates, reviews them semantically, applies policy, and chooses red alerts, amber digests, or gray silence.",
    "model": "qwen/qwen3.5-27b",
    "matrix": {
      "localpartPrefix": "mail-sentinel"
    },
    "requiredToolTemplates": [
      {
        "id": "mail-sentinel-tool",
        "version": "2.0.0"
      },
      {
        "id": "imap-readonly",
        "version": "1.0.0"
      }
    ],
    "optionalToolTemplates": []
  }
}
