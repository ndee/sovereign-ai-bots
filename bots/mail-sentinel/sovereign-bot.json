{
  "kind": "sovereign-bot-package",
  "id": "mail-sentinel",
  "version": "1.5.0",
  "displayName": "Mail Sentinel",
  "description": "Local-first inbox sentinel that filters heuristic candidates, reviews them with Lobster plus llm-task, applies personal policy, and chooses red, amber, or gray handling.",
  "defaultInstall": true,
  "helloMessage": "Hello from Mail Sentinel 1.5. I prefilter inbox signals, review candidates semantically through Lobster, apply your policy, and route mail into red alerts, amber digests, or gray silence.",
  "matrixIdentity": {
    "mode": "dedicated-account",
    "localpartPrefix": "mail-sentinel"
  },
  "matrixRouting": {
    "dm": {
      "enabled": true
    },
    "alertRoom": {
      "autoReply": true,
      "requireMention": false
    }
  },
  "configDefaults": {
    "agentId": "mail-sentinel",
    "imapInstanceId": "mail-sentinel-imap",
    "pollInterval": "5m",
    "lookbackWindow": "15m",
    "defaultReminderDelay": "4h",
    "digestInterval": "12h",
    "e2eeAlertRoom": false,
    "statePath": "data/mail-sentinel-state.json",
    "rulesPath": "config/default-rules.json",
    "policyPath": "config/user-policy.json",
    "openclawUrl": "http://127.0.0.1:18789",
    "llmModel": "qwen/qwen3.5-9b",
    "llmTimeoutMs": 30000
  },
  "toolTemplates": [
    {
      "kind": "sovereign-tool-template",
      "id": "mail-sentinel-tool",
      "version": "1.5.0",
      "description": "Local-first mail watcher for heuristic candidate filtering, Lobster semantic review, policy-driven zoning, digests, and feedback tuning.",
      "capabilities": [
        "mail-sentinel.scan",
        "mail-sentinel.feedback",
        "mail-sentinel.alerts.read"
      ],
      "openclawBundledPlugins": [
        "lobster",
        "llm-task"
      ],
      "openclawToolNames": [
        "lobster",
        "llm-task"
      ],
      "requiredSecretRefs": [],
      "requiredConfigKeys": [
        "agentId",
        "imapInstanceId",
        "statePath",
        "rulesPath",
        "policyPath",
        "openclawUrl",
        "llmModel"
      ],
      "allowedCommands": [
        "<agent-workspace>/bin/mail-sentinel.mjs scan --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs digest --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs list-alerts --instance <tool-instance-id> --view today --json",
        "<agent-workspace>/bin/mail-sentinel.mjs list-alerts --instance <tool-instance-id> --view recent --json",
        "<agent-workspace>/bin/mail-sentinel.mjs policy list --instance <tool-instance-id> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs policy important-sender --instance <tool-instance-id> --query <query> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs policy add --instance <tool-instance-id> --type <type> --match <pattern> --min-zone <zone> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs policy remove --instance <tool-instance-id> --id <policy-id> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action important --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action not-important --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action less-often --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action remind-later --delay <duration> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action always-like-this --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --latest --action reduce --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action important --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action not-important --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action less-often --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action remind-later --delay <duration> --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action always-like-this --json",
        "<agent-workspace>/bin/mail-sentinel.mjs feedback --instance <tool-instance-id> --alert-id <alert-id> --action reduce --json"
      ]
    }
  ],
  "toolInstances": [
    {
      "id": "mail-sentinel-imap",
      "templateRef": "imap-readonly@1.0.0",
      "enabledWhen": {
        "path": "imap.status",
        "equals": "configured"
      },
      "config": {
        "host": {
          "from": "imap.host"
        },
        "port": {
          "from": "imap.port",
          "stringify": true
        },
        "tls": {
          "from": "imap.tls",
          "stringify": true
        },
        "username": {
          "from": "imap.username"
        },
        "mailbox": {
          "from": "imap.mailbox"
        }
      },
      "secretRefs": {
        "password": {
          "from": "imap.secretRef"
        }
      }
    },
    {
      "id": "mail-sentinel-core",
      "templateRef": "mail-sentinel-tool@1.5.0",
      "config": {
        "agentId": {
          "from": "bots.config.mail-sentinel.agentId"
        },
        "imapInstanceId": {
          "from": "bots.config.mail-sentinel.imapInstanceId"
        },
        "statePath": {
          "from": "bots.config.mail-sentinel.statePath"
        },
        "rulesPath": {
          "from": "bots.config.mail-sentinel.rulesPath"
        },
        "policyPath": {
          "from": "bots.config.mail-sentinel.policyPath"
        },
        "lookbackWindow": {
          "from": "bots.config.mail-sentinel.lookbackWindow"
        },
        "defaultReminderDelay": {
          "from": "bots.config.mail-sentinel.defaultReminderDelay"
        },
        "digestInterval": {
          "from": "bots.config.mail-sentinel.digestInterval"
        },
        "openclawUrl": {
          "from": "bots.config.mail-sentinel.openclawUrl"
        },
        "llmModel": {
          "from": "bots.config.mail-sentinel.llmModel"
        },
        "llmTimeoutMs": {
          "from": "bots.config.mail-sentinel.llmTimeoutMs",
          "stringify": true
        }
      },
      "secretRefs": {}
    }
  ],
  "openclaw": {
    "cron": {
      "id": "mail-sentinel-poll",
      "everyConfigKey": "pollInterval",
      "defaultEvery": "5m",
      "session": "isolated",
      "announce": false,
      "message": "Run the Mail Sentinel scan command from TOOLS.md for the configured instance. Do not summarize the inbox manually. Do not add extra commentary beyond the tool result."
    }
  },
  "agentTemplate": {
    "id": "mail-sentinel",
    "version": "1.5.0",
    "description": "Local-first inbox sentinel that filters heuristic candidates, reviews them semantically, applies policy, and chooses red alerts, amber digests, or gray silence.",
    "model": "qwen/qwen3.5-9b",
    "matrix": {
      "localpartPrefix": "mail-sentinel"
    },
    "requiredToolTemplates": [
      {
        "id": "mail-sentinel-tool",
        "version": "1.5.0"
      },
      {
        "id": "imap-readonly",
        "version": "1.0.0"
      }
    ],
    "optionalToolTemplates": [],
    "workspaceFiles": [
      {
        "path": "README.md",
        "source": "workspace/README.md"
      },
      {
        "path": "AGENTS.md",
        "source": "workspace/AGENTS.md"
      },
      {
        "path": "TOOLS.md",
        "source": "workspace/TOOLS.md"
      },
      {
        "path": "skills/mail-sentinel-core/SKILL.md",
        "source": "workspace/skills/mail-sentinel-core/SKILL.md"
      },
      {
        "path": "bin/mail-sentinel.mjs",
        "source": "workspace/bin/mail-sentinel.mjs",
        "mode": "755"
      },
      {
        "path": "config/default-rules.json",
        "source": "workspace/config/default-rules.json"
      },
      {
        "path": "config/user-policy.json",
        "source": "workspace/config/user-policy.json"
      },
      {
        "path": "data/README.md",
        "source": "workspace/data/README.md"
      }
    ]
  }
}
