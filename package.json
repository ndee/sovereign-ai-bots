{
  "name": "sovereign-ai-bots",
  "version": "2.0.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "validate-catalog": "./dist/validate-catalog.js",
    "probe-mail-sentinel-chat-model": "./dist/probe-mail-sentinel-chat-model.js"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "catalog:lint": "tsx src/bin/validate-catalog.ts lint",
    "catalog:typecheck": "tsx src/bin/validate-catalog.ts typecheck",
    "catalog:test": "tsx src/bin/validate-catalog.ts test",
    "catalog:smoke": "tsx src/bin/validate-catalog.ts smoke",
    "probe:mail-sentinel-model": "tsx src/bin/probe-mail-sentinel-chat-model.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^22.18.5",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packages": {
    "": {
      "version": "2.0.9"
    }
  }
}
